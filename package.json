{
  "name": "airbnb-listing-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:e2e",
    "visual:capture": "node scripts/capture.mjs --url http://localhost:3100/ --out artifacts/clone --states",
    "visual:diff": "node scripts/visual-diff.mjs --ref reference/screens --clone artifacts/clone --out artifacts/diff",
    "measure": "node scripts/measure.mjs",
    "package": "node scripts/package-submission.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5"
  }
}
